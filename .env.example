# Copy to .env for local runs. NEVER commit .env.
# On Render/Railway set these as environment variables instead.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
PORT=3000
# Device is marked OFFLINE after this many seconds without data (limit 30)
OFFLINE_AFTER_S=20
# Only for tools/replay.js (the device token, typed in your shell, not committed)
# DEVICE_TOKEN=
# SERVER_BASE=https://smartclass-t05.onrender.com
